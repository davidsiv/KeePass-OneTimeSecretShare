<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{6F1A2C3D-9B47-4E0A-8C21-7D5F0A1B2C3E}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>OneTimeSecretShare</RootNamespace>
    <AssemblyName>OneTimeSecretShare</AssemblyName>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <!-- KeePass.exe and KeePassLib are referenced automatically by the
         KeePass PLGX compiler; do not list them here. -->
    <!-- Only assemblies from KeePass's default PLGX compile set are listed.
         System.Security is intentionally NOT referenced: DPAPI is invoked via
         reflection in OtsConfig.cs so that KeePass can compile the .plgx with
         its fixed reference set. Adding non-default references here makes
         KeePass silently fail to compile the plugin. -->
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="OneTimeSecretShareExt.cs" />
    <Compile Include="OtsClient.cs" />
    <Compile Include="OtsClipboard.cs" />
    <Compile Include="OtsConfig.cs" />
    <Compile Include="OtsJson.cs" />
    <Compile Include="OtsOptionsForm.cs" />
    <Compile Include="OtsResultForm.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
